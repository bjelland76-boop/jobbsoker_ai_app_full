# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
backend/.venv/
backend/venv/

# Local databases / generated files
*.db
backend/generated_pdfs/
generated_pdfs/

# Env files
.env
backend/.env

# Node / Expo / Web
node_modules/
mobile/node_modules/
web/node_modules/

.expo/
mobile/.expo/

# Vite / web builds
web/dist/

# Expo exports / web build output
# NOTE: these are build artifacts regenerated by `expo export` + `cap sync` before every
# Gradle build (see mobile/build-android.sh). Committing them let stale bundles silently
# survive branch switches / checkouts and ship in release builds.
mobile/dist/
mobile/android/app/src/main/assets/public/

# Capacitor native projects (usually generated locally)
web/android/
web/ios/
web/.capacitor/

# Logs
*.log
